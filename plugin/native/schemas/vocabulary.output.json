{
  "type":"object",
  "description":"The correction list after the call. revision advances by one with every change and is the value the next change must name. applies is always next_session: a session already open keeps the list it opened with. changed is present on correct and forget and says whether the list was changed.",
  "properties":{
    "revision":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "rules":{"type":"array","maxItems":64,"items":{"type":"object","properties":{"heard":{"type":"string","minLength":1,"maxLength":64},"meant":{"type":"string","minLength":1,"maxLength":64}},"required":["heard","meant"],"additionalProperties":false}},
    "limits":{"type":"object","properties":{"rules":{"type":"integer","const":64},"bytes":{"type":"integer","const":64},"heard_words":{"type":"integer","const":4}},"required":["rules","bytes","heard_words"],"additionalProperties":false},
    "applies":{"type":"string","enum":["next_session"]},
    "changed":{"type":"boolean"}
  },
  "required":["revision","rules","limits","applies"],
  "additionalProperties":false
}
